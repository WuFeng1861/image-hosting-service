# ── 依赖与构建产物 ─────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── 日志 ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 运行时数据（SQLite 库 / 上传的图片）──────────────
# 数据库为运行时生成，含 WAL / SHM 边车文件，不进版本库
data/*.db
data/*.db-wal
data/*.db-shm
uploadImage/

# ── 环境变量（示例文件必须保留）──────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.production.example
!.env-example
!example.env

# ── 编辑器 / 系统 ─────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store

# ── 测试与杂项 ─────────────────────────────────────
coverage/
.nyc_output/
_tmp_*
*.tar.gz

# ── 补丁/备份残留 ───────────────────────────────────
*.orig
*.rej
*.bak
